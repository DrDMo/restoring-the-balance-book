# --- Data files (large / third-party / sensitive) ---
# Track folder structure but ignore raw data dumps by default.
# To commit a specific file, use: git add -f Data/path/to/file
Data/**/*.csv
Data/**/*.tsv
Data/**/*.parquet
Data/**/*.feather
Data/**/*.dta
Data/**/*.sav
Data/**/*.sas7bdat
Data/**/*.xlsx
Data/**/*.xls
Data/**/*.zip
Data/**/*.gz
Data/**/*.7z
Data/**/*.rds
Data/**/*.RData

# Keep folder structure markers
!**/.gitkeep

# --- Logs / temp ---
*.log
*.tmp
tmp/
logs/

# --- Secrets ---
*.pem
*.key
secrets.*
.envrc

# --- Local data (raw and processed; never committed) ---
data/
